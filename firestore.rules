rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own data.
    // NOTE: Firestore allows a request if ANY matching rule allows it, so this wildcard also covers
    // the logbook documents below and makes their extra write guards inactive (tested in the emulator).
    // Narrowing this rule is NOT a safe quick fix: the guards below then deny deleting a year document,
    // which would break account deletion. Test any change in the emulator first.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // Logbook data — intended to block any write that would replace a non-empty logbookData map
    // with {}. Currently inactive: the wildcard above already allows these writes (see note there).
    match /users/{uid}/logbook/data {
      allow read: if request.auth.uid == uid;

      allow write: if request.auth.uid == uid
        && !(
          // Document already exists with non-empty logbookData...
          resource != null
          && 'logbookData' in resource.data
          && resource.data.logbookData.size() > 0
          // ...and the incoming write would make logbookData empty
          && 'logbookData' in request.resource.data
          && request.resource.data.logbookData.size() == 0
        );
    }

    // Per-year logbook shards — sibling docs in the same `logbook` collection,
    // keyed by year (e.g. "2026"), alongside the legacy "data" doc above. Same
    // intended anti-data-loss guard, equally inactive (see the note on the wildcard); it would
    // also only catch an empty months map, while the app writes blank rows instead. The split
    // exists so no single document approaches Firestore's 1 MiB limit over a multi-decade career.
    match /users/{uid}/logbook/{year} {
      allow read: if request.auth.uid == uid;

      allow write: if request.auth.uid == uid
        && !(
          // Document already exists with non-empty months...
          resource != null
          && 'months' in resource.data
          && resource.data.months.size() > 0
          // ...and the incoming write would make months empty
          && 'months' in request.resource.data
          && request.resource.data.months.size() == 0
        );
    }

    // Feedback submissions — any signed-in user can create.
    // A user may read and anonymise (GDPR erasure) ONLY their own submissions:
    // update is limited to blanking uid + email to '[deleted]'.
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == '[deleted]'
        && request.resource.data.email == '[deleted]';
    }

    // Diagnostic log for failed email-verification links. Write-only — no
    // client can read these back. Lets us see the real Firebase error code
    // instead of guessing why a verification link died.
    match /verificationErrors/{docId} {
      allow create: if true;
    }

    // Public data (if needed)
    match /public/{document=**} {
      allow read: if true;
    }
  }
}

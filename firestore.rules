rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read/write their own data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // Logbook data — tighter write rule overrides the wildcard above
    // Prevents any write that would replace a non-empty logbookData map with {}
    match /users/{uid}/logbook/data {
      allow read: if request.auth.uid == uid;

      allow write: if request.auth.uid == uid
        && !(
          // Document already exists with non-empty logbookData...
          resource != null
          && 'logbookData' in resource.data
          && resource.data.logbookData.size() > 0
          // ...and the incoming write would make logbookData empty
          && 'logbookData' in request.resource.data
          && request.resource.data.logbookData.size() == 0
        );
    }

    // Feedback submissions — any signed-in user can create.
    // A user may read and anonymise (GDPR erasure) ONLY their own submissions:
    // update is limited to blanking uid + email to '[deleted]'.
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == '[deleted]'
        && request.resource.data.email == '[deleted]';
    }

    // Public data (if needed)
    match /public/{document=**} {
      allow read: if true;
    }
  }
}
